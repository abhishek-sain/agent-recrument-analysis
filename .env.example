# SQL Server
# Note: pymssql needs the db name passed separately from special chars in URL;
# if your db name has a hyphen, keep it as-is here - pymssql handles it fine.
DATABASE_URL=mssql+pymssql://sa:your_password@your_host:1433/user-management

# Base URL of the frontend app that will render the onboarding link.
# The frontend dev owns this route; backend only issues tokens.
FRONTEND_BASE_URL=http://localhost:3000

# CORS - comma separated list of allowed origins (frontend app URL(s))
CORS_ORIGINS=http://localhost:3000

# File storage: "local" or "s3"
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads

# Only needed if STORAGE_BACKEND=s3
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Public URL this API is served at - only used to populate the OpenAPI
# "servers" list so /docs "Try it out" and any imported Swagger spec hit
# the right host.
API_PUBLIC_URL=https://grid.leadsgenerations.in/recrument-analysis

# Set this if your reverse proxy STRIPS /recrument-analysis before
# forwarding to this app (i.e. uvicorn's own logs show plain paths like
# "/docs", not "/recrument-analysis/docs" - check with `journalctl -u
# <service> -f` while hitting the live URL). Without this, links FastAPI
# generates itself (like the openapi.json URL inside the /docs page)
# come out root-relative and 404 through the proxy.
# Leave blank ONLY if the proxy does NOT strip the prefix (the app itself
# receives the full /recrument-analysis/... path).
ROOT_PATH=/recrument-analysis
