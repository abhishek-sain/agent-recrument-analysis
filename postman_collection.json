    {
      "name": "Admin (Ops Review)",
      "item": [
        {
          "name": "List Onboarding Records",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/onboarding?status=UNDER_REVIEW",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "onboarding"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "UNDER_REVIEW",
                  "description": "Optional. One of LINK_GENERATED, FORM_IN_PROGRESS, SUBMITTED, UNDER_REVIEW, SEND_BACK, REJECTED, APPROVED, ACTIVE"
                }
              ]
            }
          }
        },
        {
          "name": "Review - Approve",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"APPROVE\",\n  \"reviewed_by\": \"OPS01\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/onboarding/{{record_id}}/review",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "onboarding",
                "{{record_id}}",
                "review"
              ]
            },
            "description": "Approves and activates the record (status -> ACTIVE). Also stamps joining_date the first time this happens - this feeds the Ageing Report."
          }
        },
        {
          "name": "Review - Reject",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"REJECT\",\n  \"reviewed_by\": \"OPS01\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/onboarding/{{record_id}}/review",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "onboarding",
                "{{record_id}}",
                "review"
              ]
            }
          }
        },
        {
          "name": "Review - Send Back",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.new_onboarding_url) { console.log('New link issued:', data.new_onboarding_url); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"SEND_BACK\",\n  \"reviewed_by\": \"OPS01\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/onboarding/{{record_id}}/review",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "onboarding",
                "{{record_id}}",
                "review"
              ]
            },
            "description": "Rotates the onboarding token and returns a fresh new_onboarding_url to resend to the POS/Referral."
          }
        },
        {
          "name": "Convert to POS",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"converted_by\": \"OPS01\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/onboarding/{{record_id}}/convert-to-pos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "onboarding",
                "{{record_id}}",
                "convert-to-pos"
              ]
            },
            "description": "Manually promotes an active POS Referral to a full POS. Only works when user_type=POS_REFERRAL and status=ACTIVE. Stamps pos_conversion_date, which feeds the Ageing Report."
          }
        },
        {
          "name": "List Users Data",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/users-data?limit=50&offset=0",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "users-data"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Max rows to return (1-200)."
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": "Rows to skip, for paging."
                }
              ]
            },
            "description": "Full users_data table, paginated (default 50, max 200 per page). Each row includes its document_details (PAN/Aadhaar/bank), joined on users_data_id - null if that record has not saved any yet."
          }
        },
        {
          "name": "Get Users Data by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/users-data/{{record_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "users-data",
                "{{record_id}}"
              ]
            },
            "description": "Single users_data row by its id (e.g. TKT-12-09-2026-143059-7), including its document_details (PAN/Aadhaar/bank), joined on users_data_id - null if not saved yet."
          }
        },
        {
          "name": "List Document Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/document-details?limit=50&offset=0",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "document-details"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Max rows to return (1-200)."
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": "Rows to skip, for paging."
                }
              ]
            },
            "description": "Full document_details table - PAN/Aadhaar/Education structured fields for every record."
          }
        },
        {
          "name": "Get Document Details by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/document-details/{{document_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "document-details",
                "{{document_id}}"
              ]
            },
            "description": "Single document_details row by its own id (e.g. DOC-12-09-2026-143059-4), not users_data_id."
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Ageing Report",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/reports/ageing",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "reports",
                "ageing"
              ]
            },
            "description": "Date of Joining -> POS Referral -> POS Conversion Date. Lists every record that is currently a POS Referral (PENDING) or was converted from one (CONVERTED), with ageing_days and within_90_days (90 days is a target to measure against, not an enforced cutoff - referrals don't auto-expire or auto-convert)."
          }
        }
      ]
    }
  ]
}
