{
  "info": {
    "name": "POS / POS Referral Onboarding API",
    "description": "FastAPI backend for the digital onboarding flow: SM link generation, self-onboarding for POS / POS Referral, document upload, ops approval workflow, POS Referral -> POS conversion, and the Ageing Report. Backed by 2 SQL Server tables - users_data (Table-1) and document_details (Table-2: PAN/Aadhaar/Education extracted fields). Record ids are human-readable ticket ids like TKT-12-09-2026-143059-7 (users_data) / DOC-12-09-2026-143059-4 (document_details), not UUIDs. Login/auth is provided by an existing system and is NOT part of this collection.\n\nFlow to test end-to-end:\n1. Links > Generate Onboarding Link (SM) - sets {{token}} and {{record_id}} automatically\n2. Links > Resolve Link (Frontend)\n3. Onboarding > Save Form\n4. Documents > Upload Document (run once per doc_type)\n5. Onboarding > Submit\n6. Admin > List Under Review\n7. Admin > Review (Approve / Reject / Send Back) - APPROVE stamps joining_date\n8. Admin > Convert to POS - only for an ACTIVE POS_REFERRAL record; stamps pos_conversion_date\n9. Reports > Ageing Report - Date of Joining -> POS Referral -> POS Conversion Date, with ageing_days and within_90_days",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "pos-onboarding-api-collection"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "record_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "document_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Links",
      "item": [
        {
          "name": "Generate Onboarding Link (SM)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('token', data.token);",
                  "pm.collectionVariables.set('record_id', data.id);",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has onboarding_url', () => pm.expect(data.onboarding_url).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ramesh Kumar\",\n  \"number\": \"9876543210\",\n  \"email\": \"ramesh@example.com\",\n  \"user_type\": \"POS\",\n  \"raised_by\": \"SM001\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/links/generate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "links",
                "generate"
              ]
            },
            "description": "Called by the SM app after login. Creates the users_data row and returns a token + shareable URL (copy link / WhatsApp / SMS). user_type is POS or POS_REFERRAL."
          }
        },
        {
          "name": "Resolve Link (Frontend prefill)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/links/{{token}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "links",
                "{{token}}"
              ]
            },
            "description": "Called by the frontend's onboarding page on load to validate the token and fetch prefill data (name, number, user_type, status) before rendering the form."
          }
        }
      ]
    },
    {
      "name": "Onboarding",
      "item": [
        {
          "name": "Get Onboarding Record",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/onboarding/{{token}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "onboarding",
                "{{token}}"
              ]
            }
          }
        },
        {
          "name": "Save Form",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dob\": \"1990-01-15\",\n  \"email\": \"ramesh@example.com\",\n  \"city\": \"Pune\",\n  \"state\": \"Maharashtra\",\n  \"pincode\": \"411001\",\n  \"consent\": \"AGREE\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/onboarding/{{token}}/form",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "onboarding",
                "{{token}}",
                "form"
              ]
            },
            "description": "Upserts dob, email, city, state, pincode, consent. Same endpoint/body shape for both POS and POS Referral. Can be called multiple times. terms_and_conditions is NOT part of this payload - see 'Update Terms & Conditions' below."
          }
        },
        {
          "name": "Update Terms & Conditions",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"terms_and_conditions\": \"we can use your data for onboarding you\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/onboarding/{{token}}/terms-and-conditions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "onboarding",
                "{{token}}",
                "terms-and-conditions"
              ]
            },
            "description": "Edits ONLY terms_and_conditions, independently of Save Form. This field is fixed to 'we can use your data for onboarding you' when the record is created; this is the only way to change it afterward."
          }
        },
        {
          "name": "Submit (Review & Submit)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/onboarding/{{token}}/submit",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "onboarding",
                "{{token}}",
                "submit"
              ]
            },
            "description": "Validates required fields/documents (name, number, consent, pan_card, aadhaar, photograph), runs a duplicate mobile-number check, and moves the record to UNDER_REVIEW."
          }
        }
      ]
    },
