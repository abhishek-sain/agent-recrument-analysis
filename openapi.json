          },
          "pos_conversion_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pos Conversion Date"
          },
          "ageing_days": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ageing Days"
          },
          "conversion_status": {
            "type": "string",
            "title": "Conversion Status"
          },
          "within_90_days": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
