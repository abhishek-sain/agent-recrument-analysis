          "id",
          "name",
          "number",
          "raised_by",
          "date_of_joining",
          "pos_conversion_date",
          "ageing_days",
          "conversion_status",
          "within_90_days"
        ],
        "title": "AgeingReportItem",
        "description": "One row of the Ageing Report: how long a POS Referral has been (or\nwas) a referral before converting to a POS.\n\nconversion_status:\n  - \"CONVERTED\": already promoted to POS - ageing_days is final.\n  - \"PENDING\": still an active POS Referral - ageing_days counts up\n    to today, and within_90_days tells you if the 90-day target has\n    already been missed."
      },
