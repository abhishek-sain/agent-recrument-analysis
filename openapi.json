                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/reports/ageing": {
      "get": {
        "tags": [
          "reports"
        ],
        "summary": "Ageing Report",
        "description": "Date of Joining -> POS Referral -> POS Conversion Date.\n\nIncludes every record that either currently is a POS Referral\n(pending conversion) or was converted from one (pos_conversion_date\nis set) - a plain POS that was never a referral has neither and is\nexcluded.",
        "operationId": "ageing_report_api_v1_admin_reports_ageing_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AgeingReportItem"
                  },
                  "type": "array",
                  "title": "Response Ageing Report Api V1 Admin Reports Ageing Get"
