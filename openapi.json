    "/api/v1/admin/onboarding/{record_id}/convert-to-pos": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Convert To Pos",
        "description": "Manually promotes an active POS Referral to a full POS. Feeds the\nAgeing Report: joining_date (set on approval) and pos_conversion_date\n(set here) together give the \"how long were they a referral\" duration.",
        "operationId": "convert_to_pos_api_v1_admin_onboarding__record_id__convert_to_pos_post",
        "parameters": [
          {
            "name": "record_id",
            "in": "path",
