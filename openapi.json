      "post": {
        "tags": [
          "onboarding"
        ],
        "summary": "Submit Form",
        "description": "Final \"Review & Submit\" step. Runs basic form/document validation and\na duplicate check, then moves the record into the approval workflow\n(UNDER_REVIEW), matching the \"System Processing\" stage in the flow.",
        "operationId": "submit_form_api_v1_onboarding__token__submit_post",
        "parameters": [
